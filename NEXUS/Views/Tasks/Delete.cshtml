@model NEXUS.Models.TaskItem

@{
    ViewData["Title"] = "Delete Task";
}

<div class="space-y-6 max-w-3xl mx-auto">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-red-500/20 text-red-400 border border-red-500/30 flex items-center justify-center text-sm shadow-neon-red">
                    <i class="fa-solid fa-trash"></i>
                </div>
                Delete Task
            </h1>
            <p class="text-sm text-slate-400 mt-1">Are you sure you want to permanently delete this task?</p>
        </div>
        <a asp-action="Index" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold px-4 py-2 rounded-xl text-sm border border-slate-700/60 transition-all flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to List</span>
        </a>
    </div>

    <!-- Alert Box -->
    <div class="bg-red-500/10 border border-red-500/30 rounded-2xl p-4 flex items-center gap-3 text-red-400 text-sm">
        <i class="fa-solid fa-triangle-exclamation text-lg"></i>
        <span>This action cannot be undone. Please review the task details below before confirming.</span>
    </div>

    <!-- Delete Card -->
    <div class="bg-slate-900/60 rounded-2xl border border-slate-800/80 backdrop-blur-xl p-8 shadow-glass space-y-6">
        <div>
            <span class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1 flex items-center gap-2">
                <i class="fa-solid fa-heading text-slate-500"></i> Task Title
            </span>
            <h2 class="text-xl font-bold text-white">@Model.Title</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4 border-t border-slate-800/80">
            <div>
                <span class="block text-xs font-semibold uppercase tracking-wider text-emerald-400 mb-2 flex items-center gap-1.5">
                    <i class="fa-solid fa-layer-group text-[10px]"></i> Project
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    <i class="fa-solid fa-layer-group text-[10px]"></i>
                    @(Model.Project?.Name ?? "Unassigned")
                </span>
            </div>

            <div>
                <span class="block text-xs font-semibold uppercase tracking-wider text-cyan-400 mb-2 flex items-center gap-1.5">
                    <i class="fa-solid fa-tag text-[10px]"></i> Task Type
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
                    <i class="fa-solid fa-tag text-[10px]"></i>
                    @Model.Type
                </span>
            </div>

            <div>
                <span class="block text-xs font-semibold uppercase tracking-wider text-violet-400 mb-2 flex items-center gap-1.5">
                    <i class="fa-solid fa-user text-[10px]"></i> Assigned To
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-violet-500/10 text-violet-400 border border-violet-500/20">
                    <i class="fa-solid fa-user text-[10px]"></i>
                    @(Model.AssignedToUser?.FullName ?? Model.AssignedToUser?.UserName ?? Model.AssignedToUser?.Email ?? "Not Assigned")
                </span>
            </div>
        </div>

        <form asp-action="Delete" class="flex items-center justify-end gap-3 pt-6 border-t border-slate-800/80">
            <input type="hidden" asp-for="Id" />
            <a asp-action="Index" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm font-semibold transition-all">Cancel</a>
            <button type="submit" class="bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-500 hover:to-rose-500 text-white font-semibold px-6 py-2.5 rounded-xl text-sm shadow-lg shadow-red-500/20 transition-all flex items-center gap-2">
                <i class="fa-solid fa-trash"></i>
                <span>Yes, Delete</span>
            </button>
        </form>
    </div>
</div>