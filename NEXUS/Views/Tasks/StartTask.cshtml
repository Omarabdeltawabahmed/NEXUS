@model NEXUS.Models.TaskItem

@{
    ViewData["Title"] = "Start Task - " + Model.Title;
}

<div class="max-w-4xl mx-auto space-y-8 py-6">

    <!-- Task Header Card -->
    <div class="glass-panel rounded-2xl p-8 border border-slate-800/80 shadow-glass relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex items-center justify-between mb-4">
            <span class="px-3 py-1 rounded-full text-xs font-semibold bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
                Type: @Model.Type
            </span>
            <span class="text-xs text-slate-400">Due: @Model.DueDate.ToString("yyyy-MM-dd")</span>
        </div>

        <h1 class="text-2xl font-extrabold text-white mb-3">@Model.Title</h1>

        <!-- عرض وصف المهمة -->
        <p class="text-slate-300 text-sm leading-relaxed mb-6 bg-slate-950/40 p-4 rounded-xl border border-slate-800/60">
            @Model.Description
        </p>

        <div class="flex items-center gap-6 text-xs text-slate-400 pt-4 border-t border-slate-800/80">
            <div>Project: <span class="text-white font-medium">@(Model.Project != null ? Model.Project.Name : "General")</span></div>
            <div>Priority: <span class="text-white font-medium">@Model.Priority</span></div>
        </div>
    </div>

    <!-- Submission / Execution Form Section -->
    <div class="glass-panel rounded-2xl p-8 border border-slate-800/80 shadow-glass">
        <h3 class="text-lg font-bold text-white mb-6">Task Execution & Submission</h3>

        <form asp-action="SubmitTask" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="space-y-6">

            @if (Model.Type == NEXUS.Enums.TaskType.Meeting)
            {
                <!-- Meeting Join Section -->
                <div class="bg-cyan-500/10 border border-cyan-500/20 p-6 rounded-2xl text-center space-y-3">
                    <h4 class="text-white font-semibold text-base">Meeting Session</h4>
                    <p class="text-xs text-slate-300">Click the button below to join the scheduled meeting.</p>
                    @if (!string.IsNullOrEmpty(Model.MeetingLink))
                    {
                        <div>
                            <a href="@Model.MeetingLink" target="_blank" class="inline-flex items-center gap-2 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold px-6 py-3 rounded-xl text-sm transition-all shadow-neon-cyan">
                                <i class="fa-solid fa-video"></i>
                                <span>Join Meeting Now</span>
                            </a>
                        </div>
                    }
                    else
                    {
                        <p class="text-xs text-yellow-400">No meeting link provided by the administrator yet.</p>
                    }
                </div>
            }
            else if (Model.Type == NEXUS.Enums.TaskType.Testing)
            {
                <!-- Testing API Link & Results Section -->
                <div class="space-y-6">
                    <!-- API Testing Link Box -->
                    <div class="bg-violet-500/10 border border-violet-500/20 p-6 rounded-2xl space-y-3">
                        <h4 class="text-white font-semibold text-sm">API Testing Link</h4>
                        <p class="text-xs text-slate-300">Use the link below to test the target API endpoint:</p>
                        @if (!string.IsNullOrEmpty(Model.ApiLink))
                        {
                            <div>
                                <a href="@Model.ApiLink" target="_blank" class="text-cyan-400 hover:underline text-xs font-mono break-all bg-slate-950 p-3 rounded-xl block border border-slate-800">
                                    <i class="fa-solid fa-link mr-2"></i>@Model.ApiLink
                                </a>
                            </div>
                        }
                        else
                        {
                            <p class="text-xs text-yellow-400">No API link provided.</p>
                        }
                    </div>

                    <!-- Test Results Textarea Area -->
                    <div class="space-y-2">
                        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">Insert your Test Results here...</label>
                        <textarea name="submissionContent" rows="6" placeholder="Paste Postman/Swagger response, test logs, or overall results here..."
                                  class="w-full bg-[#0b101d] border border-slate-800 text-white rounded-xl p-4 font-mono text-sm focus:outline-none focus:border-cyan-500 transition-colors">@Model.SubmissionContent</textarea>
                    </div>

                    <!-- Optional File Upload for Testing Evidence -->
                    <div class="space-y-2">
                        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">Upload Test Report / Screenshot (Optional)</label>
                        <div id="dropzone-box" class="border-2 border-dashed border-slate-700/80 hover:border-cyan-500/50 rounded-2xl p-6 text-center cursor-pointer transition-all bg-slate-950/40 relative group">
                            <input type="file" name="uploadedFile" id="real-file-input" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />

                            <div id="upload-prompt" class="space-y-2 pointer-events-none">
                                <div class="w-10 h-10 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 flex items-center justify-center mx-auto transition-transform group-hover:scale-110">
                                    <i class="fa-solid fa-cloud-arrow-up text-sm"></i>
                                </div>
                                <p class="text-xs text-slate-300"><span class="font-semibold text-cyan-400">Click to upload</span> or drag and drop</p>
                            </div>

                            <div id="file-info-preview" class="hidden items-center justify-between bg-slate-900/90 border border-slate-700/60 rounded-xl p-3 relative z-25">
                                <div class="flex items-center gap-3 truncate">
                                    <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center justify-center shrink-0">
                                        <i class="fa-solid fa-file-arrow-up text-xs text-emerald-400"></i>
                                    </div>
                                    <div class="text-left truncate">
                                        <p id="file-name-display" class="text-xs font-semibold text-white truncate max-w-xs"></p>
                                        <p id="file-size-display" class="text-[10px] text-slate-400"></p>
                                    </div>
                                </div>
                                <button type="button" id="remove-file-btn" class="text-slate-400 hover:text-red-400 p-2 rounded-lg hover:bg-slate-800 transition-all z-30">
                                    <i class="fa-solid fa-xmark text-xs"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (Model.Type == NEXUS.Enums.TaskType.CodeSubmission || Model.Type == NEXUS.Enums.TaskType.BugFixing)
            {
                <!-- Code / Text Submission Area -->
                <div class="space-y-2">
                    <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">Source Code / Solution Notes</label>
                    <textarea name="submissionContent" rows="8" placeholder="Write or paste your code solution here..."
                              class="w-full bg-[#0b101d] border border-slate-800 text-white rounded-xl p-4 font-mono text-sm focus:outline-none focus:border-cyan-500 transition-colors">@Model.SubmissionContent</textarea>
                </div>
            }
            else
            {
                <!-- File / Photo Upload Area -->
                <div class="space-y-2">
                    <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">Upload File or Screenshot</label>

                    <!-- Dropzone Container -->
                    <div id="dropzone-box" class="border-2 border-dashed border-slate-700/80 hover:border-cyan-500/50 rounded-2xl p-8 text-center cursor-pointer transition-all bg-slate-950/40 relative group">

                        <!-- Hidden Real File Input -->
                        <input type="file" name="uploadedFile" id="real-file-input" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />

                        <!-- Default View -->
                        <div id="upload-prompt" class="space-y-3 pointer-events-none">
                            <div class="w-12 h-12 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 flex items-center justify-center mx-auto transition-transform group-hover:scale-110">
                                <i class="fa-solid fa-cloud-arrow-up text-lg"></i>
                            </div>
                            <div>
                                <p class="text-xs text-slate-300"><span class="font-semibold text-cyan-400">Click to upload</span> or drag and drop</p>
                                <p class="text-[10px] text-slate-500 mt-1">Supports code files, documents, or images</p>
                            </div>
                        </div>

                        <!-- Selected File Preview View (Hidden by default) -->
                        <div id="file-info-preview" class="hidden items-center justify-between bg-slate-900/90 border border-slate-700/60 rounded-xl p-4 relative z-25">
                            <div class="flex items-center gap-3 truncate">
                                <div class="w-10 h-10 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center justify-center shrink-0">
                                    <i class="fa-solid fa-file-arrow-up text-base text-emerald-400"></i>
                                </div>
                                <div class="text-left truncate">
                                    <p id="file-name-display" class="text-xs font-semibold text-white truncate max-w-xs"></p>
                                    <p id="file-size-display" class="text-[10px] text-slate-400"></p>
                                </div>
                            </div>
                            <button type="button" id="remove-file-btn" class="text-slate-400 hover:text-red-400 p-2 rounded-lg hover:bg-slate-800 transition-all z-30">
                                <i class="fa-solid fa-xmark text-sm"></i>
                            </button>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.SubmissionContent))
                {
                    <div class="text-xs text-emerald-400 bg-emerald-500/10 p-3 rounded-xl border border-emerald-500/20">
                        Current Submitted File: <a href="@Model.SubmissionContent" target="_blank" class="underline font-bold">View File</a>
                    </div>
                }
            }

            <!-- Action Buttons -->
            <div class="flex items-center justify-end gap-4 pt-4 border-t border-slate-800/80">
                <a asp-action="Index" class="px-6 py-2.5 rounded-xl text-xs font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 transition-colors">
                    Back to Tasks
                </a>
                <button type="submit" class="px-6 py-2.5 rounded-xl text-xs font-semibold bg-gradient-to-r from-cyan-500 to-violet-500 text-white shadow-lg shadow-cyan-500/20 hover:opacity-90 transition-opacity flex items-center gap-2">
                    <i class="fa-solid fa-check"></i> Submit Task
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const fileInput = document.getElementById('real-file-input');
            const uploadPrompt = document.getElementById('upload-prompt');
            const fileInfoPreview = document.getElementById('file-info-preview');
            const fileNameDisplay = document.getElementById('file-name-display');
            const fileSizeDisplay = document.getElementById('file-size-display');
            const removeFileBtn = document.getElementById('remove-file-btn');

            if (fileInput) {
                fileInput.addEventListener('change', function() {
                    if (fileInput.files && fileInput.files[0]) {
                        const file = fileInput.files[0];
                        fileNameDisplay.textContent = file.name;
                        fileSizeDisplay.textContent = (file.size / (1024 * 1024)).toFixed(2) + ' MB';

                        uploadPrompt.classList.add('hidden');
                        fileInfoPreview.classList.remove('hidden');
                        fileInfoPreview.classList.add('flex');
                    }
                });

                if (removeFileBtn) {
                    removeFileBtn.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        fileInput.value = '';
                        fileInfoPreview.classList.add('hidden');
                        fileInfoPreview.classList.remove('flex');
                        uploadPrompt.classList.remove('hidden');
                    });
                }
            }
        });
    </script>
}