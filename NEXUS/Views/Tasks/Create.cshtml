@model NEXUS.Models.TaskItem

@{
    ViewData["Title"] = "Create Task";
}

<div class="max-w-3xl mx-auto space-y-6">
    <!-- Page Header (Matched with Projects Style) -->
    <div class="bg-slate-900/60 p-6 rounded-2xl border border-slate-800/80 backdrop-blur-xl shadow-glass flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 shadow-neon-cyan">
                <i class="fa-solid fa-plus text-xl"></i>
            </div>
            <div>
                <h1 class="text-xl font-bold tracking-tight text-white">Create New Task</h1>
                <p class="text-xs text-slate-400 mt-0.5">Add a new task and assign it to a specific project.</p>
            </div>
        </div>
        <a asp-action="Index" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold px-4 py-2 rounded-xl text-sm border border-slate-700/60 transition-all flex items-center gap-2 w-fit">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to List</span>
        </a>
    </div>

    <!-- Form Card -->
    <div class="bg-slate-900/60 p-8 rounded-2xl border border-slate-800/80 backdrop-blur-xl shadow-glass">
        <form asp-action="Create" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="text-red-400 text-xs bg-red-500/10 border border-red-500/20 p-3 rounded-xl"></div>

            <!-- Title -->
            <div class="space-y-2">
                <label asp-for="Title" class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Task Title</label>
                <input asp-for="Title" placeholder="e.g. Design Database Schema" class="w-full bg-slate-950/60 border border-slate-700/60 rounded-xl px-4 py-3 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/30 transition-all duration-300" />
                <span asp-validation-for="Title" class="text-red-400 text-xs"></span>
            </div>

            <!-- Project Dropdown -->
            <div class="space-y-2 relative">
                <label asp-for="ProjectId" class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Project</label>
                <div class="relative">
                    <select asp-for="ProjectId" class="w-full bg-slate-950/80 border border-slate-700/60 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/30 transition-all duration-300 appearance-none cursor-pointer" asp-items="ViewBag.ProjectId">
                        <option value="">-- Select Project --</option>
                    </select>
                    <span class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-slate-400">
                        <i class="fa-solid fa-chevron-down text-xs"></i>
                    </span>
                </div>
                <span asp-validation-for="ProjectId" class="text-red-400 text-xs"></span>
            </div>

            <!-- Task Type Dropdown -->
            <div class="space-y-2 relative">
                <label asp-for="Type" class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Task Type</label>
                <div class="relative">
                    <select asp-for="Type" id="TaskTypeSelect" class="w-full bg-slate-950/80 border border-slate-700/60 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/30 transition-all duration-300 appearance-none cursor-pointer" asp-items="Html.GetEnumSelectList<NEXUS.Enums.TaskType>()">
                        <option value="">-- Select Task Type --</option>
                    </select>
                    <span class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-slate-400">
                        <i class="fa-solid fa-chevron-down text-xs"></i>
                    </span>
                </div>
                <span asp-validation-for="Type" class="text-red-400 text-xs"></span>
            </div>

            <!-- Assign To User Dropdown -->
            <div class="space-y-2 relative">
                <label asp-for="AssignedToUserId" class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Assign To User</label>
                <div class="relative">
                    <select asp-for="AssignedToUserId" class="w-full bg-slate-950/80 border border-slate-700/60 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/30 transition-all duration-300 appearance-none cursor-pointer" asp-items="ViewBag.AssignedToUserId">
                        <option value="">-- Select User --</option>
                    </select>
                    <span class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-slate-400">
                        <i class="fa-solid fa-chevron-down text-xs"></i>
                    </span>
                </div>
                <span asp-validation-for="AssignedToUserId" class="text-red-400 text-xs"></span>
            </div>

            <!-- Priority -->
            <div class="space-y-2 relative">
                <label asp-for="Priority" class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Priority</label>
                <div class="relative">
                    <select asp-for="Priority" asp-items="Html.GetEnumSelectList<NEXUS.Enums.TaskPriority>()" class="w-full bg-slate-950/80 border border-slate-700/60 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/30 transition-all duration-300 appearance-none cursor-pointer">
                    </select>
                    <span class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-slate-400">
                        <i class="fa-solid fa-chevron-down text-xs"></i>
                    </span>
                </div>
                <span asp-validation-for="Priority" class="text-red-400 text-xs"></span>
            </div>

            <!-- Due Date with Calendar Icon -->
            <div class="space-y-2">
                <label asp-for="DueDate" class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Due Date</label>
                <div class="relative">
                    <input asp-for="DueDate" type="date" class="w-full bg-slate-950/60 border border-slate-700/60 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/30 transition-all duration-300 cursor-pointer" />
                    <span class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-slate-400">
                        <i class="fa-regular fa-calendar text-sm"></i>
                    </span>
                </div>
                <span asp-validation-for="DueDate" class="text-red-400 text-xs"></span>
            </div>

            <!-- Description -->
            <div class="space-y-2">
                <label asp-for="Description" class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Description</label>
                <textarea asp-for="Description" id="TaskDescription" rows="3" placeholder="Enter task details..." class="w-full bg-slate-950/60 border border-slate-700/60 rounded-xl px-4 py-3 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/30 transition-all duration-300"></textarea>
                <span asp-validation-for="Description" class="text-red-400 text-xs"></span>
            </div>

            <!-- Meeting Link Container (Hidden by default) -->
            <div class="space-y-2 hidden" id="MeetingLinkContainer">
                <label class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Meeting Link</label>
                <input type="text" name="MeetingLink" placeholder="Paste Meeting Link Here..." class="w-full bg-slate-950/60 border border-slate-700/60 rounded-xl px-4 py-3 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/30 transition-all duration-300" />
            </div>

            <!-- Testing API Link Container (Hidden by default) -->
            <div class="space-y-2 hidden" id="TestingLinkContainer">
                <label class="text-xs font-semibold text-slate-300 uppercase tracking-wider">API Link</label>
                <input type="text" name="ApiLink" placeholder="Paste API link Here..." class="w-full bg-slate-950/60 border border-slate-700/60 rounded-xl px-4 py-3 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/30 transition-all duration-300" />
            </div>

            <!-- Actions -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800">
                <a asp-action="Index" class="px-5 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800 transition-all">Cancel</a>
                <button type="submit" class="bg-gradient-to-r from-cyan-500 to-violet-600 hover:from-cyan-400 hover:to-violet-500 text-white font-semibold px-6 py-2.5 rounded-xl text-sm shadow-neon-cyan transition-all">Create Task</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function() {
            // جلب المستخدمين عند تغيير المشروع
            $('#ProjectId').change(function() {
                var projectId = $(this).val();
                var userDropdown = $('#AssignedToUserId');

                userDropdown.empty();
                userDropdown.append('<option value="">-- Select User --</option>');

                if (projectId) {
                    $.ajax({
                        url: '@Url.Action("GetUsersByProject", "Tasks")',
                        type: 'GET',
                        data: { projectId: projectId },
                        success: function(data) {
                            $.each(data, function(i, user) {
                                userDropdown.append($('<option></option>').val(user.id).text(user.name));
                            });
                        },
                        error: function() {
                            console.error('Failed to retrieve users for this project.');
                        }
                    });
                }
            });

            // التفاعل مع نوع المهمة (Task Type)
            $('#TaskTypeSelect').change(function() {
                var selectedType = $(this).find("option:selected").text().trim();
                var descInput = $('#TaskDescription');
                var meetingContainer = $('#MeetingLinkContainer');
                var testingContainer = $('#TestingLinkContainer');

                // إخفاء الحقول الإضافية وإعادة الوصف للافتراضي أولاً
                meetingContainer.addClass('hidden');
                testingContainer.addClass('hidden');
                descInput.attr('placeholder', 'Enter task details...');

                if (selectedType === 'BugFixing') {
                    descInput.attr('placeholder', 'Insert Code to fix Bugs Here..');
                } else if (selectedType === 'Meeting') {
                    meetingContainer.removeClass('hidden');
                } else if (selectedType === 'Testing') {
                    testingContainer.removeClass('hidden');
                }
            });
        });
    </script>
}