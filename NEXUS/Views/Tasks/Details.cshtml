@model NEXUS.Models.TaskItem

@{
    ViewData["Title"] = "Task Details";
}

<div class="space-y-6 max-w-4xl mx-auto">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-violet-500/20 text-violet-400 border border-violet-500/30 flex items-center justify-center text-sm shadow-neon-violet">
                    <i class="fa-solid fa-eye"></i>
                </div>
                Task Details
            </h1>
            <p class="text-sm text-slate-400 mt-1">Viewing comprehensive information about this task.</p>
        </div>
        <a asp-action="Index" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold px-4 py-2 rounded-xl text-sm border border-slate-700/60 transition-all flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to List</span>
        </a>
    </div>

    <!-- Details Card -->
    <div class="bg-slate-900/60 rounded-2xl border border-slate-800/80 backdrop-blur-xl p-8 shadow-glass space-y-6">
        <div>
            <span class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1 flex items-center gap-2">
                <i class="fa-solid fa-heading text-slate-500"></i> Task Title
            </span>
            <h2 class="text-xl font-bold text-white">@Model.Title</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4 border-t border-slate-800/80">
            <div>
                <span class="block text-xs font-semibold uppercase tracking-wider text-emerald-400 mb-2 flex items-center gap-1.5">
                    <i class="fa-solid fa-layer-group text-[10px]"></i> Project
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    <i class="fa-solid fa-layer-group text-[10px]"></i>
                    @(Model.Project?.Name ?? "Unassigned")
                </span>
            </div>

            <div>
                <span class="block text-xs font-semibold uppercase tracking-wider text-cyan-400 mb-2 flex items-center gap-1.5">
                    <i class="fa-solid fa-tag text-[10px]"></i> Task Type
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
                    <i class="fa-solid fa-tag text-[10px]"></i>
                    @Model.Type
                </span>
            </div>

            <div>
                <span class="block text-xs font-semibold uppercase tracking-wider text-violet-400 mb-2 flex items-center gap-1.5">
                    <i class="fa-solid fa-user text-[10px]"></i> Assigned To
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-violet-500/10 text-violet-400 border border-violet-500/20">
                    <i class="fa-solid fa-user text-[10px]"></i>
                    @(Model.AssignedToUser?.FullName ?? Model.AssignedToUser?.UserName ?? Model.AssignedToUser?.Email ?? "Not Assigned")
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4 border-t border-slate-800/80">
            <div>
                <span class="block text-xs font-semibold uppercase tracking-wider text-amber-400 mb-2 flex items-center gap-1.5">
                    <i class="fa-solid fa-flag text-[10px]"></i> Priority
                </span>
                @{
                    string priorityBg = Model.Priority.ToString() switch
                    {
                        "Urgent" => "bg-rose-500/10 text-rose-400 border-rose-500/30 animate-pulse",
                        "High" => "bg-red-500/10 text-red-400 border-red-500/20",
                        "Medium" => "bg-amber-500/10 text-amber-400 border-amber-500/20",
                        "Low" => "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
                        _ => "bg-slate-500/10 text-slate-400 border-slate-500/20"
                    };
                }
                <span class="px-3 py-1 rounded-md text-xs font-medium border @priorityBg inline-block">
                    @Model.Priority
                </span>
            </div>

            <div>
                <span class="block text-xs font-semibold uppercase tracking-wider text-blue-400 mb-2 flex items-center gap-1.5">
                    <i class="fa-solid fa-spinner text-[10px]"></i> Status
                </span>
                @{
                    string statusBg = Model.Status.ToString() switch
                    {
                        "Pending" => "bg-amber-500/10 text-amber-400 border-amber-500/20",
                        "InProgress" => "bg-cyan-500/10 text-cyan-400 border-cyan-500/20",
                        "Completed" => "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
                        _ => "bg-slate-500/10 text-slate-400 border-slate-500/20"
                    };
                }
                <span class="px-3 py-1 rounded-full text-xs font-medium border @statusBg inline-block">
                    @Model.Status
                </span>
            </div>

            <div>
                <span class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2 flex items-center gap-2">
                    <i class="fa-regular fa-calendar text-slate-500"></i> Due Date
                </span>
                <span class="text-slate-300 text-sm">@Model.DueDate.ToString("yyyy-MM-dd")</span>
            </div>
        </div>

        <div class="pt-4 border-t border-slate-800/80">
            <span class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2 flex items-center gap-2">
                <i class="fa-solid fa-align-left text-slate-500"></i> Description
            </span>
            <div class="bg-slate-950/60 border border-slate-800/80 rounded-xl p-4 text-slate-300 text-sm min-h-[100px]">
                @(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)
            </div>
        </div>

        <div class="flex items-center justify-end gap-3 pt-6 border-t border-slate-800/80">
            <a asp-action="Index" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm font-semibold transition-all">Back</a>
           @if(User.IsInRole("Admin"))
           {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="bg-gradient-to-r from-cyan-500 to-violet-600 hover:from-cyan-400 hover:to-violet-500 text-white font-semibold px-6 py-2.5 rounded-xl text-sm shadow-neon-cyan transition-all flex items-center gap-2">
                    <i class="fa-solid fa-pen-to-square"></i>
                    <span>Edit Task</span>
                </a>
           }
        </div>
    </div>
</div>