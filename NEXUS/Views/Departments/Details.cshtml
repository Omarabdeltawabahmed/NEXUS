@model NEXUS.Models.Department

@{
    ViewData["Title"] = "Department Details";
}

<div class="space-y-6 max-w-4xl mx-auto">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 flex items-center justify-center text-sm shadow-[0_0_15px_rgba(6,182,212,0.2)]">
                    <i class="fa-solid fa-eye"></i>
                </div>
                Department Details
            </h1>
            <p class="text-sm text-slate-400 mt-1">Viewing comprehensive information about this department.</p>
        </div>
        <a asp-action="Index" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold px-4 py-2 rounded-xl text-sm border border-slate-700/60 transition-all flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to List</span>
        </a>
    </div>

    <!-- Details Card -->
    <div class="bg-slate-900/60 rounded-2xl border border-slate-800/80 backdrop-blur-xl p-8 shadow-glass space-y-6">
        <div>
            <span class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1 flex items-center gap-2">
                <i class="fa-solid fa-building text-slate-500"></i> Department Name
            </span>
            <h2 class="text-xl font-bold text-white">@Model?.Name</h2>
        </div>

        <div class="pt-4 border-t border-slate-800/80">
            <span class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2 flex items-center gap-2">
                <i class="fa-solid fa-align-left text-slate-500"></i> Description
            </span>
            <div class="bg-slate-950/60 border border-slate-800/80 rounded-xl p-4 text-slate-300 text-sm min-h-[100px]">
                @(string.IsNullOrEmpty(Model?.Description) ? "No description provided for this department." : Model.Description)
            </div>
        </div>

        <!-- Associated Projects List Preview -->
        <div class="space-y-3 pt-4 border-t border-slate-800/80">
            <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-2">
                <i class="fa-solid fa-layer-group text-slate-500"></i> Associated Projects
            </h3>
            @if (Model?.Projects != null && Model.Projects.Any())
            {
                <div class="space-y-2">
                    @foreach (var project in Model.Projects)
                    {
                        <div class="bg-slate-950/60 p-3 rounded-xl border border-slate-800/60 flex items-center justify-between text-sm">
                            <span class="text-white font-medium">@project.Name</span>
                            <span class="text-xs px-3 py-1 rounded-full font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                                @project.Status
                            </span>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-xs text-slate-500 italic bg-slate-950/40 p-4 rounded-xl border border-slate-800/40">No projects are currently linked to this department.</p>
            }
        </div>

        <div class="flex items-center justify-end gap-3 pt-6 border-t border-slate-800/80">
            <a asp-action="Index" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm font-semibold transition-all">Back</a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="bg-gradient-to-r from-cyan-500 to-violet-600 hover:from-cyan-400 hover:to-violet-500 text-white font-semibold px-6 py-2.5 rounded-xl text-sm shadow-neon-cyan transition-all flex items-center gap-2">
                    <i class="fa-solid fa-pen-to-square"></i>
                    <span>Edit Department</span>
                </a>
            }
        </div>
    </div>
</div>