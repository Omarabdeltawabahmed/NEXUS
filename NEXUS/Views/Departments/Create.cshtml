@model NEXUS.Models.Department

@{
    ViewData["Title"] = "Create Department";
}

<div class="max-w-3xl mx-auto space-y-6">
    <!-- Page Header -->
    <div class="bg-slate-900/60 p-6 rounded-2xl border border-slate-800/80 backdrop-blur-xl shadow-glass flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 shadow-neon-cyan">
                <i class="fa-solid fa-plus text-xl"></i>
            </div>
            <div>
                <h1 class="text-xl font-bold tracking-tight text-white">Create Department</h1>
                <p class="text-xs text-slate-400 mt-0.5">Add a new operational department to the system.</p>
            </div>
        </div>
        <a asp-action="Index" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold px-4 py-2 rounded-xl text-sm border border-slate-700/60 transition-all flex items-center gap-2 w-fit">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to List</span>
        </a>
    </div>

    <!-- Form Card -->
    <div class="bg-slate-900/60 p-8 rounded-2xl border border-slate-800/80 backdrop-blur-xl shadow-glass">
        <form asp-action="Create" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="text-red-400 text-xs bg-red-500/10 border border-red-500/20 p-3 rounded-xl"></div>

            <div class="space-y-2">
                <label asp-for="Name" class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Department Name</label>
                <input asp-for="Name" placeholder="e.g. Research & Development" class="w-full bg-slate-950/60 border border-slate-700/60 rounded-xl px-4 py-3 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/30 transition-all duration-300" />
                <span asp-validation-for="Name" class="text-red-400 text-xs"></span>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800">
                <a asp-action="Index" class="px-5 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800 transition-all">Cancel</a>
                <button type="submit" class="bg-gradient-to-r from-cyan-500 to-violet-600 hover:from-cyan-400 hover:to-violet-500 text-white font-semibold px-6 py-2.5 rounded-xl text-sm shadow-neon-cyan transition-all">Create Department</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}