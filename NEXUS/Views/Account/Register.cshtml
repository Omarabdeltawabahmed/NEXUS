@model NEXUS.Controllers.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="max-w-md mx-auto mt-10 p-8 glass-panel rounded-2xl border border-slate-800/80 shadow-glass">
    <div class="text-center mb-8">
        <h1 class="text-2xl font-bold text-white">Create an Account</h1>
        <p class="text-sm text-slate-400 mt-1">Join NEXUS to manage and track your tasks</p>
    </div>

    <form asp-action="Register" method="post" class="space-y-5">
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="text-xs text-red-400 bg-red-500/10 p-3 rounded-xl border border-red-500/20"></div>
        }

        <div class="space-y-1.5">
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">Full Name</label>
            <input asp-for="FullName" class="w-full bg-[#0b101d] border border-slate-800 text-white rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-cyan-500 transition-colors" placeholder="John Doe" />
        </div>

        <div class="space-y-1.5">
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">Email Address</label>
            <input asp-for="Email" class="w-full bg-[#0b101d] border border-slate-800 text-white rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-cyan-500 transition-colors" placeholder="name@example.com" />
        </div>

        <div class="space-y-1.5">
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">Password</label>
            <input asp-for="Password" type="password" class="w-full bg-[#0b101d] border border-slate-800 text-white rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-cyan-500 transition-colors" placeholder="••••••••" />
        </div>

        <div class="space-y-1.5">
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">Confirm Password</label>
            <input asp-for="ConfirmPassword" type="password" class="w-full bg-[#0b101d] border border-slate-800 text-white rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-cyan-500 transition-colors" placeholder="••••••••" />
        </div>

        <button type="submit" class="w-full py-3 rounded-xl text-sm font-semibold bg-gradient-to-r from-cyan-500 to-violet-500 text-white shadow-lg shadow-cyan-500/20 hover:opacity-95 transition-opacity">
            Register
        </button>

        <p class="text-center text-xs text-slate-400 mt-4">
            Already have an account? <a asp-action="Login" class="text-cyan-400 hover:underline font-semibold">Login here</a>
        </p>
    </form>
</div>