@model NEXUS.Models.Team

@{
    ViewData["Title"] = "Delete Team";
}

<div class="space-y-6 max-w-xl mx-auto">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-red-500/20 text-red-400 border border-red-500/30 flex items-center justify-center text-sm shadow-[0_0_15px_rgba(239,68,68,0.2)]">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                Delete Team
            </h1>
            <p class="text-sm text-slate-400 mt-1">Are you sure you want to delete this team?</p>
        </div>
        <a asp-action="Index" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold px-4 py-2 rounded-xl text-sm border border-slate-700/60 transition-all flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to List</span>
        </a>
    </div>

    <!-- Delete Confirmation Card -->
    <div class="bg-slate-900/60 rounded-2xl border border-red-500/20 backdrop-blur-xl p-8 shadow-glass space-y-6">
        <div class="bg-red-500/10 border border-red-500/20 rounded-xl p-4 text-red-400 text-xs flex items-center gap-3">
            <i class="fa-solid fa-circle-exclamation text-base shrink-0"></i>
            <span>This action is permanent and cannot be undone. Associated projects will be unassigned from this team.</span>
        </div>

        <div class="space-y-4">
            <div>
                <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Team Name</span>
                <p class="text-sm font-bold text-white mt-1">@Model.Name</p>
            </div>

            <div>
                <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Description</span>
                <p class="text-sm text-slate-300 mt-1">@(string.IsNullOrEmpty(Model.Description) ? "No description." : Model.Description)</p>
            </div>

            <div>
                <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Total Members</span>
                <p class="text-sm text-cyan-400 font-semibold mt-1">@Model.Users.Count Members</p>
            </div>
        </div>

        <form asp-action="Delete" class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800/80">
            <input type="hidden" asp-for="Id" />
            <a asp-action="Index" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm font-semibold transition-all">Cancel</a>
            <button type="submit" class="bg-gradient-to-r from-red-600 to-rose-700 hover:from-red-500 hover:to-rose-600 text-white font-semibold px-6 py-2.5 rounded-xl text-sm shadow-[0_0_15px_rgba(239,68,68,0.3)] transition-all">Yes, Delete</button>
        </form>
    </div>
</div>