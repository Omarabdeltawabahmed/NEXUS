@model NEXUS.Models.Team

@{
    ViewData["Title"] = "Team Details";
}

<div class="space-y-6 max-w-3xl mx-auto">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 flex items-center justify-center text-sm shadow-[0_0_15px_rgba(6,182,212,0.2)]">
                    <i class="fa-solid fa-eye"></i>
                </div>
                Team Details
            </h1>
            <p class="text-sm text-slate-400 mt-1">Comprehensive overview of the team and its members.</p>
        </div>
        <a asp-action="Index" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold px-4 py-2 rounded-xl text-sm border border-slate-700/60 transition-all flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to List</span>
        </a>
    </div>

    <!-- Details Card -->
    <div class="bg-slate-900/60 rounded-2xl border border-slate-800/80 backdrop-blur-xl p-8 shadow-glass space-y-6">

        <!-- Team Name -->
        <div class="space-y-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 flex items-center gap-2">
                <i class="fa-solid fa-users text-slate-500"></i> Team Name
            </span>
            <div class="w-full bg-slate-950/60 border border-slate-800/80 rounded-xl px-4 py-3 text-white text-sm font-medium">
                @Model.Name
            </div>
        </div>

        <!-- Description -->
        <div class="space-y-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 flex items-center gap-2">
                <i class="fa-solid fa-align-left text-slate-500"></i> Description
            </span>
            <div class="w-full bg-slate-950/60 border border-slate-800/80 rounded-xl px-4 py-3 text-slate-300 text-sm min-h-[90px] leading-relaxed">
                @(string.IsNullOrEmpty(Model.Description) ? "No description provided for this team." : Model.Description)
            </div>
        </div>

        <!-- Assigned Members List -->
        <div class="space-y-3 pt-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-cyan-400 flex items-center gap-2">
                <i class="fa-solid fa-user-group text-[10px]"></i> Team Members (@Model.Users.Count)
            </span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-60 overflow-y-auto pr-1">
                @if (Model.Users != null && Model.Users.Any())
                {
                    @foreach (var user in Model.Users)
                    {
                        <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-950/60 border border-slate-800/80">
                            <div class="w-8 h-8 rounded-lg bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 flex items-center justify-center text-xs">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <span class="text-xs text-white font-medium truncate">@user.UserName</span>
                        </div>
                    }
                }
                else
                {
                    <div class="col-span-2">
                        <p class="text-xs text-slate-500 italic bg-slate-950/40 p-4 rounded-xl border border-slate-800/40 text-center">No members assigned to this team yet.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Footer Actions -->
        <div class="flex items-center justify-end gap-3 pt-6 border-t border-slate-800/80">
            <a asp-action="Index" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm font-semibold transition-all">Back</a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="bg-gradient-to-r from-cyan-500 to-violet-600 hover:from-cyan-400 hover:to-violet-500 text-white font-semibold px-6 py-2.5 rounded-xl text-sm shadow-[0_0_15px_rgba(6,182,212,0.3)] transition-all flex items-center gap-2">
                    <i class="fa-solid fa-pen-to-square"></i>
                    <span>Edit Team</span>
                </a>
            }
        </div>
    </div>
</div>