@model NEXUS.Models.Team

@{
    ViewData["Title"] = "Create Team";
}

<div class="space-y-6 max-w-3xl mx-auto">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 flex items-center justify-center text-sm shadow-[0_0_15px_rgba(6,182,212,0.2)]">
                    <i class="fa-solid fa-plus"></i>
                </div>
                Create New Team
            </h1>
            <p class="text-sm text-slate-400 mt-1">Set up a new team and assign members from the start.</p>
        </div>
        <a asp-action="Index" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold px-4 py-2 rounded-xl text-sm border border-slate-700/60 transition-all flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to List</span>
        </a>
    </div>

    <!-- Create Form Card -->
    <div class="bg-slate-900/60 rounded-2xl border border-slate-800/80 backdrop-blur-xl p-8 shadow-glass">
        <form asp-action="Create" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-red-400 text-xs mb-4"></div>

            <div>
                <label asp-for="Name" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2 flex items-center gap-2">
                    <i class="fa-solid fa-users text-slate-500"></i> Team Name
                </label>
                <input asp-for="Name" placeholder="e.g. Core Backend Squad" class="w-full bg-slate-950/60 border border-slate-800 rounded-xl px-4 py-2.5 text-white text-sm focus:outline-none focus:border-cyan-500 transition-all" />
                <span asp-validation-for="Name" class="text-xs text-red-400 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Description" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2 flex items-center gap-2">
                    <i class="fa-solid fa-align-left text-slate-500"></i> Description
                </label>
                <textarea asp-for="Description" rows="4" placeholder="Briefly describe the team's objective..." class="w-full bg-slate-950/60 border border-slate-800 rounded-xl px-4 py-2.5 text-white text-sm focus:outline-none focus:border-cyan-500 transition-all"></textarea>
                <span asp-validation-for="Description" class="text-xs text-red-400 mt-1 block"></span>
            </div>

            <!-- Team Members Grid Selection -->
            <div class="space-y-3 pt-4 border-t border-slate-800">
                <label class="block text-xs font-semibold uppercase tracking-wider text-cyan-400 flex items-center gap-1.5">
                    <i class="fa-solid fa-user-check text-[10px]"></i> Assign Members
                </label>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-60 overflow-y-auto pr-1">
                    @{
                        var allUsers = ViewBag.AllUsers as List<NEXUS.Models.ApplicationUser>;
                    }
                    @if (allUsers != null && allUsers.Any())
                    {
                        @foreach (var user in allUsers)
                        {
                            <label class="relative flex items-center justify-between p-3.5 rounded-xl bg-slate-950/60 border border-slate-800 hover:border-slate-700 cursor-pointer transition-all duration-200 group">
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-lg bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 flex items-center justify-center font-bold text-xs shrink-0">
                                        <i class="fa-solid fa-user"></i>
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="text-xs text-white font-bold">@user.FullName</span>
                                        <span class="text-[11px] text-slate-400">@user.Email</span>
                                    </div>
                                </div>
                                <input type="checkbox" name="selectedUserIds" value="@user.Id"
                                       onchange="this.closest('label').classList.toggle('border-cyan-500/50', this.checked); this.closest('label').classList.toggle('bg-cyan-500/10', this.checked); this.closest('label').classList.toggle('border-slate-800', !this.checked);"
                                       class="w-4 h-4 rounded bg-slate-900 border-slate-700 text-cyan-500 focus:ring-cyan-500/30 cursor-pointer">
                            </label>
                        }
                    }
                    else
                    {
                        <div class="col-span-2">
                            <p class="text-xs text-slate-500 italic bg-slate-950/40 p-4 rounded-xl border border-slate-800/40 text-center">No available users found.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center justify-end gap-3 pt-6 border-t border-slate-800/80">
                <a asp-action="Index" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm font-semibold transition-all">Cancel</a>
                <button type="submit" class="bg-gradient-to-r from-cyan-500 to-violet-600 hover:from-cyan-400 hover:to-violet-500 text-white font-semibold px-6 py-2.5 rounded-xl text-sm shadow-[0_0_15px_rgba(6,182,212,0.3)] transition-all">Create Team</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}