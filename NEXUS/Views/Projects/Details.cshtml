@model NEXUS.Models.Project

@{
    ViewData["Title"] = "Project Details";
}

<div class="space-y-6 max-w-4xl mx-auto">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center text-sm shadow-[0_0_15px_rgba(16,185,129,0.2)]">
                    <i class="fa-solid fa-eye"></i>
                </div>
                Project Details
            </h1>
            <p class="text-sm text-slate-400 mt-1">Viewing comprehensive information about this project.</p>
        </div>
        <a asp-action="Index" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold px-4 py-2 rounded-xl text-sm border border-slate-700/60 transition-all flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to List</span>
        </a>
    </div>

    <!-- Details Card -->
    <div class="bg-slate-900/60 rounded-2xl border border-slate-800/80 backdrop-blur-xl p-8 shadow-glass space-y-6">
        <div>
            <span class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1 flex items-center gap-2">
                <i class="fa-solid fa-heading text-slate-500"></i> Project Name
            </span>
            <h2 class="text-xl font-bold text-white">@Model?.Name</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-slate-800/80">
            <div>
                <span class="block text-xs font-semibold uppercase tracking-wider text-cyan-400 mb-2 flex items-center gap-1.5">
                    <i class="fa-solid fa-building text-[10px]"></i> Department
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
                    <i class="fa-solid fa-building text-[10px]"></i>
                    @(Model?.Department?.Name ?? "Unassigned")
                </span>
            </div>
        </div>

        <div class="pt-4 border-t border-slate-800/80">
            <span class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2 flex items-center gap-2">
                <i class="fa-solid fa-align-left text-slate-500"></i> Description
            </span>
            <div class="bg-slate-950/60 border border-slate-800/80 rounded-xl p-4 text-slate-300 text-sm min-h-[100px]">
                @(string.IsNullOrEmpty(Model?.Description) ? "No description provided for this project." : Model.Description)
            </div>
        </div>

        <!-- Associated Tasks List Preview -->
        <div class="space-y-3 pt-4 border-t border-slate-800/80">
            <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-2">
                <i class="fa-solid fa-square-check text-slate-500"></i> Associated Tasks
            </h3>
            @if (Model?.Tasks != null && Model.Tasks.Any())
            {
                <div class="space-y-2">
                    @foreach (var task in Model.Tasks)
                    {
                        <div class="bg-slate-950/60 p-3 rounded-xl border border-slate-800/60 flex items-center justify-between text-sm">
                            <span class="text-white font-medium">@task.Title</span>
                            <span class="text-xs px-3 py-1 rounded-full font-semibold @(task.Status == NEXUS.Enums.TaskStatus.Completed ? "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20" : "bg-amber-500/10 text-amber-400 border border-amber-500/20")">
                                @task.Status
                            </span>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-xs text-slate-500 italic bg-slate-950/40 p-4 rounded-xl border border-slate-800/40">No tasks are currently linked to this project.</p>
            }
        </div>

        <!-- Project Team Members Section (عرض فقط بدون أزرار تعديل) -->
        <div class="space-y-3 pt-4 border-t border-slate-800/80">
            <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-2">
                <i class="fa-solid fa-users text-slate-500"></i> Project Team Members
            </h3>

            @if (Model?.Users != null && Model.Users.Any())
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    @foreach (var user in Model.Users)
                    {
                        <div class="bg-slate-950/60 p-3 rounded-xl border border-slate-800/60 flex items-center justify-between text-sm">
                            <div class="flex items-center gap-2">
                                <div class="w-8 h-8 rounded-lg bg-violet-500/20 text-violet-400 border border-violet-500/30 flex items-center justify-center font-bold text-xs">
                                    @(string.IsNullOrEmpty(user.FullName) ? (string.IsNullOrEmpty(user.UserName) ? "U" : user.UserName.Substring(0, 1).ToUpper()) : user.FullName.Substring(0, 1).ToUpper())
                                </div>
                                <span class="text-white font-medium">@(user.FullName ?? user.UserName)</span>
                            </div>
                            <span class="text-[10px] px-2 py-0.5 rounded-full bg-violet-500/10 text-violet-400 border border-violet-500/20">Member</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-xs text-slate-500 italic bg-slate-950/40 p-4 rounded-xl border border-slate-800/40">No team members assigned to this project yet.</p>
            }
        </div>

        <div class="flex items-center justify-end gap-3 pt-6 border-t border-slate-800/80">
            <a asp-action="Index" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm font-semibold transition-all">Back</a>
           @if(User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="bg-gradient-to-r from-cyan-500 to-violet-600 hover:from-cyan-400 hover:to-violet-500 text-white font-semibold px-6 py-2.5 rounded-xl text-sm shadow-neon-cyan transition-all flex items-center gap-2">
                    <i class="fa-solid fa-pen-to-square"></i>
                    <span>Edit Project</span>
                </a>
            }
        </div>
    </div>
</div>