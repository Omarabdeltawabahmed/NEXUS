@model NEXUS.Models.Project

@{
    ViewData["Title"] = "Create Project";
    var allUsers = ViewBag.AllUsers as List<NEXUS.Models.ApplicationUser> ?? new List<NEXUS.Models.ApplicationUser>();
    var teamsList = ViewBag.TeamsList as List<NEXUS.Models.Team> ?? new List<NEXUS.Models.Team>();
}

<div class="max-w-3xl mx-auto space-y-6">
    <!-- Page Header -->
    <div class="bg-slate-900/60 p-6 rounded-2xl border border-slate-800/80 backdrop-blur-xl shadow-glass flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 shadow-[0_0_15px_rgba(16,185,129,0.2)]">
                <i class="fa-solid fa-plus text-xl"></i>
            </div>
            <div>
                <h1 class="text-xl font-bold tracking-tight text-white">Create New Project</h1>
                <p class="text-xs text-slate-400 mt-0.5">Add a new project, assign it to a department, and select a team or members.</p>
            </div>
        </div>
        <a asp-action="Index" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold px-4 py-2 rounded-xl text-sm border border-slate-700/60 transition-all flex items-center gap-2 w-fit">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to List</span>
        </a>
    </div>

    <!-- Form Card -->
    <div class="bg-slate-900/60 p-8 rounded-2xl border border-slate-800/80 backdrop-blur-xl shadow-glass">
        <form asp-action="Create" class="space-y-5">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-red-400 text-xs bg-red-500/10 border border-red-500/20 p-3 rounded-xl"></div>

            <div class="space-y-2">
                <label asp-for="Name" class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Project Name</label>
                <input asp-for="Name" placeholder="Enter project name..." class="w-full bg-slate-950/60 border border-slate-700/60 rounded-xl px-4 py-3 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-emerald-400 focus:ring-2 focus:ring-emerald-500/30 transition-all duration-300" />
                <span asp-validation-for="Name" class="text-red-400 text-xs"></span>
            </div>

            <div class="space-y-2">
                <label asp-for="Description" class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Description</label>
                <textarea asp-for="Description" rows="3" placeholder="Enter project description..." class="w-full bg-slate-950/60 border border-slate-700/60 rounded-xl px-4 py-3 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-emerald-400 focus:ring-2 focus:ring-emerald-500/30 transition-all duration-300"></textarea>
                <span asp-validation-for="Description" class="text-red-400 text-xs"></span>
            </div>

            <div class="space-y-2 relative">
                <label asp-for="DepartmentId" class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Department</label>
                <div class="relative">
                    <select asp-for="DepartmentId"
                            class="w-full bg-slate-950/80 border border-slate-700/60 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-emerald-400 focus:ring-2 focus:ring-emerald-500/30 transition-all duration-300 appearance-none cursor-pointer"
                            asp-items="ViewBag.DepartmentId">
                        <option value="">-- Select Department --</option>
                    </select>
                    <span class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-slate-400">
                        <i class="fa-solid fa-chevron-down text-xs"></i>
                    </span>
                </div>
                <span asp-validation-for="DepartmentId" class="text-red-400 text-xs"></span>
            </div>

            <!-- زر Assign Team to Project (اختيار تيم جاهز) -->
            <div class="space-y-2 relative pt-2 border-t border-slate-800">
                <label asp-for="TeamId" class="text-xs font-semibold text-amber-400 uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-users"></i> Assign Team (Optional)
                </label>
                <div class="relative">
                    <select asp-for="TeamId" class="w-full bg-slate-950/80 border border-slate-700/60 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-500/30 transition-all duration-300 appearance-none cursor-pointer">
                        <option value="">-- Choose a Pre-made Team --</option>
                        @foreach (var team in teamsList)
                        {
                            <option value="@team.Id">@team.Name</option>
                        }
                    </select>
                    <span class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-slate-400">
                        <i class="fa-solid fa-chevron-down text-xs"></i>
                    </span>
                </div>
                <p class="text-[11px] text-slate-500">Associating a team links them directly to this project.</p>
            </div>

            <!-- Assign Team Members Section on Create -->
            <div class="space-y-3 pt-2 border-t border-slate-800">
                <label class="text-xs font-semibold text-emerald-400 uppercase tracking-wider block">Assign Team Members</label>
                <p class="text-xs text-slate-400">Select users to be part of this project team right away.</p>

                @if (allUsers.Any())
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1 max-h-60 overflow-y-auto pr-1">
                        @foreach (var user in allUsers)
                        {
                            <label class="relative flex items-center justify-between p-3.5 rounded-xl bg-slate-950/60 border border-slate-800/60 hover:border-emerald-500/40 cursor-pointer transition-all">
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-lg bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center font-bold text-xs shrink-0">
                                        <i class="fa-solid fa-user"></i>
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="text-xs text-white font-bold">@user.UserName</span>
                                        <span class="text-[11px] text-slate-400">@user.Email</span>
                                    </div>
                                </div>
                                <input type="checkbox" name="selectedUserIds" value="@user.Id" class="w-4 h-4 text-emerald-500 bg-slate-900 border-slate-700 rounded focus:ring-emerald-500/30 focus:ring-2 cursor-pointer" />
                            </label>
                        }
                    </div>
                }
                else
                {
                    <div class="bg-slate-950/30 p-4 rounded-xl border border-slate-800/40 text-center text-slate-400 text-xs">
                        No available users found to assign.
                    </div>
                }
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800">
                <a asp-action="Index" class="px-5 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800 transition-all">Cancel</a>
                <button type="submit" class="bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-semibold px-6 py-2.5 rounded-xl text-sm shadow-[0_0_15px_rgba(16,185,129,0.3)] transition-all">Create Project</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}