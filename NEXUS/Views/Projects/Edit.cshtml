@model NEXUS.Models.Project

@{
    ViewData["Title"] = "Edit Project";
    var teamsList = ViewBag.TeamsList as List<NEXUS.Models.Team> ?? new List<NEXUS.Models.Team>();
}

<div class="space-y-6 max-w-3xl mx-auto">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-400 border border-amber-500/30 flex items-center justify-center text-sm shadow-[0_0_15px_rgba(245,158,11,0.2)]">
                    <i class="fa-solid fa-pen-to-square"></i>
                </div>
                Edit Project
            </h1>
            <p class="text-sm text-slate-400 mt-1">Modify project details, departments, teams, or member assignments.</p>
        </div>
        <a asp-action="Index" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold px-4 py-2 rounded-xl text-sm border border-slate-700/60 transition-all flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to List</span>
        </a>
    </div>

    <!-- Edit Form Card -->
    <div class="bg-slate-900/60 rounded-2xl border border-slate-800/80 backdrop-blur-xl p-8 shadow-glass">
        <form asp-action="Edit" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-red-400 text-xs mb-4"></div>
            <input type="hidden" asp-for="Id" />

            <div>
                <label asp-for="Name" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2 flex items-center gap-2">
                    <i class="fa-solid fa-heading text-slate-500"></i> Project Name
                </label>
                <input asp-for="Name" class="w-full bg-slate-950/60 border border-slate-800 rounded-xl px-4 py-2.5 text-white text-sm focus:outline-none focus:border-amber-500 transition-all" />
                <span asp-validation-for="Name" class="text-xs text-red-400 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="DepartmentId" class="block text-xs font-semibold uppercase tracking-wider text-cyan-400 mb-2 flex items-center gap-1.5">
                    <i class="fa-solid fa-building text-[10px]"></i> Department
                </label>
                <select asp-for="DepartmentId" class="w-full bg-slate-950/60 border border-cyan-500/30 rounded-xl px-4 pr-10 py-2.5 text-white text-sm focus:outline-none focus:border-cyan-500 transition-all" asp-items="ViewBag.DepartmentId">
                    <option value="">-- Select Department --</option>
                </select>
                <span asp-validation-for="DepartmentId" class="text-xs text-red-400 mt-1 block"></span>
            </div>

            <!-- زر Assign Team to Project (اختيار تيم جاهز) -->
            <div class="space-y-2 pt-2 border-t border-slate-800">
                <label asp-for="TeamId" class="block text-xs font-semibold uppercase tracking-wider text-amber-400 flex items-center gap-2">
                    <i class="fa-solid fa-users"></i> Assign Team (Optional)
                </label>
                <select asp-for="TeamId" class="w-full bg-slate-950/60 border border-slate-800 rounded-xl px-4 py-2.5 text-white text-sm focus:outline-none focus:border-amber-500 transition-all">
                    <option value="">-- Choose a Pre-made Team --</option>
                    @foreach (var team in teamsList)
                    {
                        if (Model.TeamId == team.Id)
                        {
                            <option value="@team.Id" selected="selected">@team.Name</option>
                        }
                        else
                        {
                            <option value="@team.Id">@team.Name</option>
                        }
                    }
                </select>
            </div>

            <div>
                <label asp-for="Description" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2 flex items-center gap-2">
                    <i class="fa-solid fa-align-left text-slate-500"></i> Description
                </label>
                <textarea asp-for="Description" rows="4" class="w-full bg-slate-950/60 border border-slate-800 rounded-xl px-4 py-2.5 text-white text-sm focus:outline-none focus:border-amber-500 transition-all"></textarea>
                <span asp-validation-for="Description" class="text-xs text-red-400 mt-1 block"></span>
            </div>

            <!-- Team Members Selection Section (Card Grid Style) -->
            <div class="space-y-3 pt-4 border-t border-slate-800">
                <label class="block text-xs font-semibold uppercase tracking-wider text-emerald-400 flex items-center gap-1.5">
                    <i class="fa-solid fa-user-check text-[10px]"></i> Project Team Members
                </label>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-60 overflow-y-auto pr-1">
                    @{
                        var allUsers = ViewBag.AllUsers as List<NEXUS.Models.ApplicationUser>;
                        var assignedUserIds = ViewBag.AssignedUserIds as List<string> ?? new List<string>();
                    }
                    @if (allUsers != null && allUsers.Any())
                    {
                        @foreach (var user in allUsers)
                        {
                            var isChecked = assignedUserIds.Contains(user.Id);

                            <label class="relative flex items-center justify-between p-3.5 rounded-xl bg-slate-950/60 border @(isChecked ? "border-cyan-500/50 bg-cyan-500/10" : "border-slate-800 hover:border-slate-700") cursor-pointer transition-all duration-200 group">
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-lg bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center font-bold text-xs shrink-0">
                                        <i class="fa-solid fa-user"></i>
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="text-xs text-white font-bold">@user.UserName</span>
                                        <span class="text-[11px] text-slate-400">@user.Email</span>
                                    </div>
                                </div>
                                <input type="checkbox" name="selectedUserIds" value="@user.Id" @(isChecked ? "checked" : "")
                                       onchange="this.closest('label').classList.toggle('border-cyan-500/50', this.checked); this.closest('label').classList.toggle('bg-cyan-500/10', this.checked); this.closest('label').classList.toggle('border-slate-800', !this.checked);"
                                       class="w-4 h-4 rounded bg-slate-900 border-slate-700 text-cyan-500 focus:ring-cyan-500/30 cursor-pointer">
                            </label>
                        }
                    }
                    else
                    {
                        <div class="col-span-2">
                            <p class="text-xs text-slate-500 italic bg-slate-950/40 p-4 rounded-xl border border-slate-800/40 text-center">No available users found.</p>
                        </div>
                    }
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-6 border-t border-slate-800/80">
                <a asp-action="Index" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm font-semibold transition-all">Cancel</a>
                <button type="submit" class="bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-white font-semibold px-6 py-2.5 rounded-xl text-sm shadow-[0_0_15px_rgba(245,158,11,0.3)] transition-all">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}